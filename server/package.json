{
  "name": "cryptosite-server",
  "version": "1.0.0",
  "main": "dist/server.js",
  "license": "MIT",
  "scripts": {
    "dev": "node ../node_modules/ts-node-dev/lib/bin.js --respawn --transpile-only src/server.ts",
    "build": "node ../node_modules/typescript/bin/tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "purge:users": "node ../node_modules/ts-node/dist/bin.js --transpile-only scripts/purge-users.ts",
    "lint": "node ../node_modules/eslint/bin/eslint.js \"src/**/*.{ts,tsx}\"",
    "test": "node ../node_modules/typescript/bin/tsc -p tsconfig.json && node --test dist/domain/membershipRules.test.js dist/domain/investmentLevelRules.test.js dist/domain/performanceRules.test.js dist/domain/withdrawalRules.test.js dist/domain/portfolioRules.test.js dist/domain/depositRules.test.js dist/domain/depositQuote.test.js dist/domain/ledgerRules.test.js dist/domain/transactionRules.test.js dist/domain/bonusRules.test.js dist/domain/earningsRules.test.js dist/services/marketDataService.test.js"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.14",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "socket.io": "^4.8.1",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^22.10.1",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "prettier": "^3.4.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}

