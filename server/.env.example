# NexaCrypto backend environment variables (example).
# Copy to `server/.env` and fill in real values. Never commit real credentials.

# --- Core ---
PORT=4000
NODE_ENV=production
DATABASE_URL=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
BCRYPT_SALT_ROUNDS=10
CORS_ORIGIN=
REDIS_URL=

# Base URL used to build links inside emails (verification, password reset, CTAs).
# Must be the official public domain — never a preview/staging host.
APP_BASE_URL=https://nexocrypto.org

# --- Transactional email (Resend) ---
# Backend-only secret. Set it in the backend environment (Render). NEVER set it
# in the frontend/Vercel environment.
EMAIL_ENABLED=true
RESEND_API_KEY=
# Must be a sender on the domain verified in Resend.
EMAIL_FROM=NexaCrypto <notifications@your-verified-domain.com>

# Development-only: capture outgoing messages in an in-memory outbox (never in production).
# EMAIL_DEV_OUTBOX_ENABLED=false

# --- Legacy Brevo SMTP relay (no longer used by the app) ---
# Remove these once Resend is verified in production.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_SECURE=
# SMTP_USER=
# SMTP_PASS=
